TZ={{ autobrr_timezone }}

{#
Autobrr writes a config.toml into its config directory on first start and
reads its listen address out of it from then on. Its `AUTOBRR__*` environment
variables override that file at runtime, which is what lets this role stay
authoritative about where Autobrr listens instead of depending on a file it
does not manage.

Without these, `autobrr_container_http_port` would only relabel the published
port and the Traefik service, while Autobrr itself kept listening on whatever
its own config.toml said - so any value other than the default of 7474 would
point the proxy at a port nothing is bound to.
#}
AUTOBRR__HOST=0.0.0.0
AUTOBRR__PORT={{ autobrr_container_http_port }}

{{ autobrr_environment_variables_additional_variables }}
